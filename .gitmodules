[submodule "agno_fastomop"]
	path = agno_fastomop
	url = https://github.com/ji-ch01/agno_fastomop.git
[submodule "omcp"]
	path = omcp
	url = https://github.com/ji-ch01/omcp.git
[submodule "foem"]
	path = foem
	url = https://github.com/ji-ch01/foem.git
[submodule "external/ohdsi_mimic"]
	path = external/ohdsi_mimic
	# The pinned commit adds a MIMIC-IV 2.2 config profile and
	# waveform-less/resumable outputevents scripts that are not upstream, so
	# the submodule tracks the ji-ch01 fork (which keeps OHDSI/MIMIC as its
	# `upstream` remote). Pointing this at OHDSI/MIMIC breaks
	# `git submodule update --init` on a fresh clone and in CI.
	url = https://github.com/ji-ch01/MIMIC.git
