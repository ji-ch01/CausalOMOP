# Copy this file to .env and replace placeholders locally. Never commit .env.
CAUSALOMOP_BQ_PROJECT=your-gcp-project
CAUSALOMOP_BQ_OMOP_DATASET=your-omop-dataset
CAUSALOMOP_BQ_VOCAB_DATASET=your-vocabulary-dataset
CAUSALOMOP_BQ_ETL_DATASET=your-etl-dataset
CAUSALOMOP_BQ_METRICS_DATASET=your-metrics-dataset

# Optional LLM configuration. Keep the real key only in .env.
OPENROUTER_API_KEY=your-openrouter-api-key
CAUSALOMOP_LLM_MODEL=openai/gpt-oss-120b

# LLM environment: dev allows the OpenRouter/cloud provider above; prod
# requires the local provider below and refuses to start if a cloud key is
# still set. Always dev until on-premise infrastructure is validated.
CAUSALOMOP_ENV=dev

# Local, on-premise LLM (required when CAUSALOMOP_ENV=prod). Untested against
# real infrastructure — validate against the actual on-site deployment first.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_API_KEY=not-required

# Optional: PubMed literature lookups for the Hypothesis Agent's DAG drafting.
NCBI_API_KEY=your-ncbi-api-key
